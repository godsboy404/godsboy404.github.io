{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Site.Params.description }}</description>
    <language>{{ .Site.Language.Locale }}</language>
    <atom:link href="{{ .Permalink }}rss.xml" rel="self" type="application/rss+xml" />
    {{- $pages := where .Site.RegularPages "Type" "blog" -}}
    {{- if .Data.Singular }}{{ $pages = .RegularPages }}{{ end -}}
    {{- range first 10 $pages.ByDate.Reverse }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <guid>{{ .Params.rss_guid | default .Permalink }}</guid>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <description>{{ .Description }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
